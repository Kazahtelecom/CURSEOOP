# Локальная ведомость может содержать учебные данные и не публикуется.
outputs/

# Логотипы сторонних организаций: условия публичного распространения не установлены.
assets/logo-*.png

# Локальные параметры, ключи и сертификаты.
.env
.env.*
!.env.example
*.pem
*.key

# Временные данные Python и виртуальные окружения.
__pycache__/
*.py[cod]
.venv/
venv/

# Локальные журналы и файлы ОС.
*.log
.DS_Store
Thumbs.db
